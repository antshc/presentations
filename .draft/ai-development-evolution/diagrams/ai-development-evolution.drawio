                <mxCell id="s07-dmsg" parent="s07-detail" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontColor=#5B6672;fontFamily=Inter;" value="The same seven ideas become concrete practices, skills, and durable artifacts." vertex="1">
