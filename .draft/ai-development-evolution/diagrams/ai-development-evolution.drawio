                <mxCell id="s02-pack-title" parent="s02-detail-layer" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=23;fontStyle=1;fontColor=#222B35;fontFamily=Kalam;" value="Skill packs: difference &amp;amp; intent" vertex="1">
                    <mxGeometry height="42" width="560" x="2680" y="428" as="geometry"/>
                </mxCell>
                <mxCell id="s02-pack1" parent="s02-detail-layer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Osmani · the SDLC, no metaphor required&lt;/b&gt;&lt;br&gt;&lt;b&gt;Difference:&lt;/b&gt; six stages (define → ship) as slash commands; 25 skills, 4 reviewer personas, anti-rationalization tables.&lt;br&gt;&lt;b&gt;Intent:&lt;/b&gt; a disciplined, verifiable process for teams; adopt gradually." vertex="1">
                    <mxGeometry height="112" width="560" x="2680" y="474" as="geometry"/>
                </mxCell>
                <mxCell id="s02-pack2" parent="s02-detail-layer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Pocock · agree first, then build&lt;/b&gt;&lt;br&gt;&lt;b&gt;Difference:&lt;/b&gt; small, composable, hackable skills (grill me, glossary, decision records, specs, tickets); against heavy frameworks.&lt;br&gt;&lt;b&gt;Intent:&lt;/b&gt; align on the design before any code; fuzzy problems, long-lived codebases." vertex="1">
                    <mxGeometry height="112" width="560" x="2680" y="594" as="geometry"/>
                </mxCell>
                <mxCell id="s02-pack3" parent="s02-detail-layer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;pstack · the best spec is the code&lt;/b&gt;&lt;br&gt;&lt;b&gt;Difference:&lt;/b&gt; no planning skills; effort goes to investigation, verification and multimodal review after the build.&lt;br&gt;&lt;b&gt;Intent:&lt;/b&gt; prove the work instead of trusting the build pass; hard bugs, migrations, overnight agents." vertex="1">
                    <mxGeometry height="112" width="560" x="2680" y="714" as="geometry"/>
                </mxCell>
