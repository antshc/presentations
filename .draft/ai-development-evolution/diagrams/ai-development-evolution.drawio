    <diagram name="P4.1 ASF Examples (04)" id="mSsw-tZuRRp6JbyEJY5N">
        <mxGraphModel dx="2544" dy="7000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FAF8F2" math="0" shadow="0">
            <root>
                <mxCell id="XQLSOlmbkDenEewqiwLT-0"/>
                <mxCell id="XQLSOlmbkDenEewqiwLT-1" parent="XQLSOlmbkDenEewqiwLT-0" value="Main screen"/>
                <mxCell id="XQLSOlmbkDenEewqiwLT-4" parent="XQLSOlmbkDenEewqiwLT-0" value="Detail screen"/>
                <mxCell id="XQLSOlmbkDenEewqiwLT-5" parent="XQLSOlmbkDenEewqiwLT-4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF8F2;strokeColor=#CBC5B5;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="900" width="1600" x="1700" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-6" parent="XQLSOlmbkDenEewqiwLT-4" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=44;fontStyle=1;fontColor=#222B35;fontFamily=Kalam;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DKalam;" value="Stage 3 Runs Work. Stage 4 Operates Delivery." vertex="1">
                    <mxGeometry height="70" width="1180" x="1760" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-7" parent="XQLSOlmbkDenEewqiwLT-4" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#5B6672;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" value="Four real systems and where each sits between a bounded workflow and a managed pipeline." vertex="1">
                    <mxGeometry height="42" width="1320" x="1760" y="104" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-8" parent="XQLSOlmbkDenEewqiwLT-4" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#5B6672;fontFamily=Inter;" value="DETAIL" vertex="1">
                    <mxGeometry height="36" width="110" x="3130" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-9" parent="XQLSOlmbkDenEewqiwLT-4" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=16;fontColor=#5B6672;fontFamily=Inter;" value="04 / 09" vertex="1">
                    <mxGeometry height="30" width="180" x="3080" y="850" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-10" parent="XQLSOlmbkDenEewqiwLT-4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=3;fontSize=17;fontColor=#222B35;align=left;spacing=12;fontFamily=Inter;" value="&lt;b style=&#39;font-size:24px;font-family:Kalam&#39;&gt;Warp Factories&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&#39;font-size:13px;color:#047857&#39;&gt;&lt;b&gt;STAGE 4 · HOSTED PRODUCT · EARLY ACCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;What:&lt;/b&gt; Cloud agents on your repos; a foreman routes Slack, GitHub, Linear and Jira work to a reviewed PR.&lt;br&gt;&lt;b&gt;Owns the loop:&lt;/b&gt; The foreman agent plus factory-as-code definitions. Humans approve spec and PR; it never merges.&lt;br&gt;&lt;b&gt;Intended for:&lt;/b&gt; A managed work-item → reviewed-PR pipeline across repos, with a dashboard, scorers and benchmarks." vertex="1">
                    <mxGeometry height="120" width="1480" x="1760" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-11" parent="XQLSOlmbkDenEewqiwLT-4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=3;fontSize=17;fontColor=#222B35;align=left;spacing=12;fontFamily=Inter;" value="&lt;b style=&#39;font-size:24px;font-family:Kalam&#39;&gt;Atlassian AI SDLC&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&#39;font-size:13px;color:#047857&#39;&gt;&lt;b&gt;STAGE 4 · OPERATING MODEL, NOT A PRODUCT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;What:&lt;/b&gt; A playbook: context graph + measurement beneath five reshaped SDLC workflows (plan to maintain).&lt;br&gt;&lt;b&gt;Owns the loop:&lt;/b&gt; People and governed agent loops, with Jira and Confluence as systems of record.&lt;br&gt;&lt;b&gt;Intended for:&lt;/b&gt; Org-wide change of the whole lifecycle: agents take routine work, people keep judgment." vertex="1">
                    <mxGeometry height="120" width="1480" x="1760" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-12" parent="XQLSOlmbkDenEewqiwLT-4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FFFDF7;strokeColor=#6B5E4B;strokeWidth=3;dashed=1;fontSize=17;fontColor=#222B35;align=left;spacing=16;fontFamily=Inter;" value="&lt;b&gt;Do not collapse the stages:&lt;/b&gt; durable, event-triggered autonomy can still be one Stage 3 workflow. Stage 4 adds shared operational responsibility across runs.&lt;br&gt;&lt;i&gt;Stage placement of the four systems is this talk&#39;s reading of their public docs, not a vendor claim.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="100" width="900" x="1760" y="745" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-13" parent="XQLSOlmbkDenEewqiwLT-4" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=16;fontStyle=1;fontColor=#5B6672;fontFamily=Inter;" value="FOUR REFERENCE POINTS · SAME WORD, DIFFERENT JOBS" vertex="1">
                    <mxGeometry height="32" width="1480" x="1760" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="XQLSOlmbkDenEewqiwLT-14" parent="XQLSOlmbkDenEewqiwLT-4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;fontSize=17;fontColor=#222B35;align=left;spacing=12;fontFamily=Inter;" value="&lt;b style=&quot;font-size:24px;font-family:Kalam&quot;&gt;Super Simple Software Factory&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 13px; color: rgb(180, 83, 9);&quot;&gt;&lt;b&gt;STAGE 3 - 4 · OPEN-SOURCE SKILL&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;What:&lt;/b&gt; Claude Code skill that stamps Python workflows into a repo; agents run as bounded, traced phases.&lt;br&gt;&lt;b&gt;Owns the loop:&lt;/b&gt; Deterministic code owns sequencing, retries and acceptance: agent proposes, code disposes.&lt;br&gt;&lt;b&gt;Intended for:&lt;/b&gt; Repeatable, observable workflows in one repo; an editable starter kit, not a managed platform." vertex="1">
                    <mxGeometry height="120" width="1480" x="1760" y="480" as="geometry"/>
                </mxCell>
