                <mxCell id="s05-footer-main-labels" parent="s05-main-layer" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontColor=#5B6672;fontFamily=Inter;" value="Architecture tests · Static analysis · Style · Local hook · Tests + mutation · Secrets · Proof" vertex="1">
                    <mxGeometry height="22" width="1370" x="60" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-layer" parent="s05-0" value="Detail screen"/>
                <mxCell id="s05-detail-paper" parent="s05-detail-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF8F2;strokeColor=#CBC5B5;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="900" width="1600" x="1700" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-title" parent="s05-detail-layer" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=44;fontStyle=1;fontColor=#222B35;fontFamily=Kalam;" value="How to Build Agentic Development with Autonomy" vertex="1">
                    <mxGeometry height="65" width="1340" x="1760" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-message" parent="s05-detail-layer" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=20;fontColor=#5B6672;fontFamily=Inter;" value="Five principles. Target design for the workshop: be sure of the design first, then code-run gates, proof, boundaries and self-improvement." vertex="1">
                    <mxGeometry height="45" width="1330" x="1760" y="92" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-pill" parent="s05-detail-layer" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#5B6672;fontFamily=Inter;" value="DETAIL" vertex="1">
                    <mxGeometry height="36" width="110" x="3130" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="s05-zone-design" parent="s05-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#F6E3DC;strokeColor=#B4533C;strokeWidth=3;fontSize=15;fontColor=#222B35;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" value="&lt;b style=&quot;font-size:22px;font-family:Kalam&quot;&gt;A · Design — be ~95% sure before agents run unattended&lt;/b&gt;&lt;br&gt;Grill the design until you would bet on it: terms in the glossary, decisions recorded, a spec with acceptance criteria (grill-with-docs → to-spec). A workshop rule of thumb, not a measured metric. Gates, proof and human approval cover the last ~5%." vertex="1">
                    <mxGeometry height="90" width="1480" x="1760" y="148" as="geometry"/>
                </mxCell>
                <mxCell id="s05-zone-a" parent="s05-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#DCEBF1;strokeColor=#2F6F8F;strokeWidth=3;fontSize=15;fontColor=#222B35;align=left;verticalAlign=top;spacing=14;fontFamily=Inter;" value="&lt;b style=&quot;font-size:22px;font-family:Kalam&quot;&gt;B · Gates — code decides&lt;/b&gt;&lt;br&gt;&lt;b&gt;Local:&lt;/b&gt; architecture, static analysis, style, fast tests.&lt;br&gt;&lt;b&gt;PR:&lt;/b&gt; repeat fast checks + full suite, broader analysis, mutation, proof run.&lt;br&gt;&lt;b&gt;After green:&lt;/b&gt; AI PR analysis.&lt;br&gt;Computational checks are deterministic. Inferential review is slower and non-deterministic. The model may act on a verdict; it may not certify itself." vertex="1">
                    <mxGeometry height="230" width="710" x="1760" y="258" as="geometry"/>
                </mxCell>
                <mxCell id="s05-zone-b" parent="s05-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#F5E6B8;strokeColor=#B8860B;strokeWidth=3;fontSize=15;fontColor=#222B35;align=left;verticalAlign=top;spacing=14;fontFamily=Inter;" value="&lt;b style=&quot;font-size:22px;font-family:Kalam&quot;&gt;C · Proof tool — evidence, not claims&lt;/b&gt;&lt;br&gt;&lt;b&gt;snack prove&lt;/b&gt; emits verdict, revision, named checks, expected vs actual, next hint and screenshot path.&lt;br&gt;&lt;b&gt;0 PASS&lt;/b&gt; · &lt;font color=&quot;#EF4444&quot;&gt;&lt;b&gt;1 FAIL: fix app&lt;/b&gt;&lt;/font&gt; · &lt;b&gt;2 can’t tell: fix setup&lt;/b&gt;.&lt;br&gt;Missing evidence never passes. Attach receipt + screenshots to the PR (recommended practice).&lt;br&gt;&lt;b&gt;Gotcha:&lt;/b&gt; a success message can appear even when nothing persisted." vertex="1">
                    <mxGeometry height="230" width="730" x="2510" y="258" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-badge1" parent="s05-detail-layer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8860B;strokeWidth=3;fontSize=20;fontStyle=1;fontColor=#222B35;fontFamily=Inter;" value="①" vertex="1">
                    <mxGeometry height="42" width="42" x="3185" y="240" as="geometry"/>
                </mxCell>
                <mxCell id="s05-zone-c" parent="s05-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FFFDF7;strokeColor=#6B5E4B;strokeWidth=3;dashed=1;fontSize=15;fontColor=#222B35;align=left;verticalAlign=top;spacing=14;fontFamily=Inter;" value="&lt;b style=&quot;font-size:22px;font-family:Kalam&quot;&gt;D · Boundaries — make right code easy&lt;/b&gt;&lt;br&gt;Folder structure encodes ownership and layers; one place per kind of knowledge. WorkOS fixes verification under &lt;b&gt;lab/verify/&lt;/b&gt;, one feature map per feature, tied together by one skill. Architecture tests enforce module/layer boundaries. Custom linter messages can carry the fix instruction." vertex="1">
                    <mxGeometry height="152" width="710" x="1760" y="504" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-badge2" parent="s05-detail-layer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B5E4B;strokeWidth=3;fontSize=19;fontStyle=1;fontColor=#222B35;fontFamily=Inter;" value="②" vertex="1">
                    <mxGeometry height="40" width="40" x="2290" y="486" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-badge3" parent="s05-detail-layer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B5E4B;strokeWidth=3;fontSize=19;fontStyle=1;fontColor=#222B35;fontFamily=Inter;" value="③" vertex="1">
                    <mxGeometry height="40" width="40" x="2335" y="486" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-badge4" parent="s05-detail-layer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B5E4B;strokeWidth=3;fontSize=19;fontStyle=1;fontColor=#222B35;fontFamily=Inter;" value="④" vertex="1">
                    <mxGeometry height="40" width="40" x="2380" y="486" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-badge5" parent="s05-detail-layer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B5E4B;strokeWidth=3;fontSize=19;fontStyle=1;fontColor=#222B35;fontFamily=Inter;" value="⑤" vertex="1">
                    <mxGeometry height="40" width="40" x="2425" y="486" as="geometry"/>
                </mxCell>
                <mxCell id="s05-zone-d" parent="s05-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FDE9E9;strokeColor=#EF4444;strokeWidth=3;fontSize=15;fontColor=#222B35;align=left;verticalAlign=top;spacing=14;fontFamily=Inter;" value="&lt;b style=&quot;font-size:22px;font-family:Kalam&quot;&gt;        E · Self-improvement — preserve the lesson&lt;/b&gt;&lt;br&gt;Every recurring failure becomes a durable artifact: a gotcha in the feature map, a new proof check, a sharper rule, or a repo-skill fix. Fowler’s steering loop improves guides and sensors when issues repeat. Agents can draft rules and structural tests; a human steers the change." vertex="1">
                    <mxGeometry height="152" width="730" x="2510" y="504" as="geometry"/>
                </mxCell>
                <mxCell id="s05-recipe" parent="s05-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=3;fontSize=15;fontColor=#222B35;align=center;spacing=10;fontFamily=Inter;" value="&lt;b&gt;ROBUST WORKFLOW&lt;/b&gt;   1 design ~95% sure   →   2 bounded task   →   3 boundaries   →   4 local gates   →   5 PR gate   →   6 proof + evidence   →   7 AI review after green   →   8 human approves merge   →   9 failures update rules / tests / maps" vertex="1">
                    <mxGeometry height="68" width="1480" x="1760" y="668" as="geometry"/>
                </mxCell>
                <mxCell id="s05-detail-footer" parent="s05-detail-layer" style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;fontStyle=1;fontColor=#5B6672;fontFamily=Inter;" value=".NET gate examples — target design; tool names are examples, not recommendations" vertex="1">
                    <mxGeometry height="24" width="1000" x="1760" y="746" as="geometry"/>
                </mxCell>
