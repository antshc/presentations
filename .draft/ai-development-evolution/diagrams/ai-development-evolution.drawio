                </mxCell>
                <mxCell id="s07-head" parent="s07-detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222B35;strokeColor=#222B35;fontSize=16;fontColor=#FFFFFF;fontFamily=Inter;align=left;spacingLeft=16;" value="&lt;b&gt;MECHANISM&lt;/b&gt;             &lt;b&gt;PRACTICE → SKILL → ARTIFACT&lt;/b&gt;" vertex="1">
                    <mxGeometry height="44" width="1480" x="1760" y="165" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r1" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#CBC5B5;fontSize=15;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="&lt;b&gt;Grilling&lt;/b&gt;&lt;br&gt;Shared understanding" vertex="1">
                    <mxGeometry height="78" width="245" x="1760" y="209" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r1b" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBC5B5;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;spacingRight=10;" value="One question + recommendation at a time; discover repo facts, then write answers immediately → &lt;b&gt;grill-with-docs / wayfinder / to-spec&lt;/b&gt; → GLOSSARY.md, ADRs, decision tickets, spec" vertex="1">
                    <mxGeometry height="78" width="1235" x="2005" y="209" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r2" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#CBC5B5;fontSize=15;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="&lt;b&gt;Ledger&lt;/b&gt;&lt;br&gt;State outside chat ①" vertex="1">
                    <mxGeometry height="68" width="245" x="1760" y="287" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r2b" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBC5B5;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;spacingRight=10;" value="Write the map, not the manual: glossary + ADRs + wayfinder index (Destination, Decisions, Fog, Out of scope) + tickets with blocking edges; sessions claim tickets" vertex="1">
                    <mxGeometry height="68" width="1235" x="2005" y="287" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r3" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#CBC5B5;fontSize=15;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="&lt;b&gt;Fan-out / Fan-in&lt;/b&gt;&lt;br&gt;Parallel frontier" vertex="1">
                    <mxGeometry height="68" width="245" x="1760" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r3b" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBC5B5;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;implement-spec&lt;/b&gt; reads the ticket graph; every unblocked ticket runs in its own worktree, then branches merge into one integration branch (needs a background-subagent harness)" vertex="1">
                    <mxGeometry height="68" width="1235" x="2005" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r4" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#CBC5B5;fontSize=15;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="&lt;b&gt;Loop&lt;/b&gt;&lt;br&gt;Build · review · fix" vertex="1">
                    <mxGeometry height="62" width="245" x="1760" y="423" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r4b" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBC5B5;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="Each implementer uses &lt;b&gt;tdd&lt;/b&gt; (red → green, one slice at a time); &lt;b&gt;code-review&lt;/b&gt; reviews the integrated result; resolved tickets close the loop" vertex="1">
                    <mxGeometry height="62" width="1235" x="2005" y="423" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r5" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#CBC5B5;fontSize=15;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="&lt;b&gt;Completeness&lt;/b&gt;&lt;br&gt;Everything there?" vertex="1">
                    <mxGeometry height="78" width="245" x="1760" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r5b" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBC5B5;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;code-review · Spec axis&lt;/b&gt; independently checks every requirement and ticket. Standards may pass while Spec fails. Stage 3 checks one run; Stage 4 can track coverage across runs (confirm before presenting). Gates/proof on slide 05 answer “does it work?”" vertex="1">
                    <mxGeometry height="78" width="1235" x="2005" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r6" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#CBC5B5;fontSize=15;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="&lt;b&gt;Agent Team&lt;/b&gt;&lt;br&gt;Bounded roles" vertex="1">
                    <mxGeometry height="68" width="245" x="1760" y="563" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r6b" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBC5B5;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="&lt;b&gt;code-review&lt;/b&gt; runs Standards and Spec in separate subagents; neither sees the other’s reasoning and the two verdicts are never blended" vertex="1">
                    <mxGeometry height="68" width="1235" x="2005" y="563" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r7" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#CBC5B5;fontSize=15;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="&lt;b&gt;Self-improvement&lt;/b&gt;&lt;br&gt;Across runs" vertex="1">
                    <mxGeometry height="68" width="245" x="1760" y="631" as="geometry"/>
                </mxCell>
                <mxCell id="s07-r7b" parent="s07-detail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBC5B5;fontSize=14;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=12;" value="Closest documented practice: growing glossary + ADRs; repo standards override generic review. An automated failure-to-rule loop is &lt;b&gt;not documented&lt;/b&gt;; a human steers it" vertex="1">
                    <mxGeometry height="68" width="1235" x="2005" y="631" as="geometry"/>
                </mxCell>
                <mxCell id="s07-afk" parent="s07-detail" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;fontSize=16;fontColor=#222B35;fontFamily=Inter;align=center;" value="&lt;b&gt;HITL decide&lt;/b&gt; — human judgment, scope, taste  →  &lt;b&gt;AFK build&lt;/b&gt; — research + implement-spec in isolated worktrees  →  &lt;b&gt;HITL approve&lt;/b&gt; — agent never merges" vertex="1">
                    <mxGeometry height="72" width="1480" x="1760" y="720" as="geometry"/>
                </mxCell>
