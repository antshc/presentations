                    <mxGeometry x="1700" y="0" width="1600" height="900" as="geometry"/>
                </mxCell>
                <mxCell id="s06-detail-title" value="What Grows Across the Four Stages?" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=44;fontStyle=1;fontColor=#222B35;fontFamily=Kalam;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="1760" y="36" width="1100" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s06-detail-message" value="The underlying model remains; capability, structure, governance and measurement accumulate around it." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#5B6672;fontFamily=Inter;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="1760" y="104" width="1300" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="s06-detail-pill" value="DETAIL" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#5B6672;fontFamily=Inter;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="3130" y="40" width="110" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s06-stage1" value="&lt;b style=&quot;font-size:26px;font-family:Kalam&quot;&gt;1 · Prompt &amp; Context&lt;/b&gt;&lt;br&gt;&lt;br&gt;Shapes what reaches the model: reusable instructions, context and examples.&lt;br&gt;&lt;br&gt;&lt;b&gt;Growth:&lt;/b&gt; context envelope" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=4;fontSize=18;fontColor=#222B35;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="1760" y="200" width="340" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="s06-stage2" value="&lt;b style=&quot;font-size:26px;font-family:Kalam&quot;&gt;2 · Agentic Development&lt;/b&gt;&lt;br&gt;&lt;br&gt;Adds an agent that can perceive the repo, decide and use tools.&lt;br&gt;&lt;br&gt;&lt;b&gt;Growth:&lt;/b&gt; agent + tools" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=4;fontSize=18;fontColor=#222B35;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="2135" y="200" width="340" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="s06-stage3" value="&lt;b style=&quot;font-size:26px;font-family:Kalam&quot;&gt;3 · Agentic Workflows&lt;/b&gt;&lt;br&gt;&lt;br&gt;Adds repeatable steps, dependencies, retries, checkpoints, verification and approvals.&lt;br&gt;&lt;br&gt;&lt;b&gt;Growth:&lt;/b&gt; workflow structure" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=4;fontSize=18;fontColor=#222B35;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="2510" y="200" width="340" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="s06-stage4" value="&lt;b style=&quot;font-size:26px;font-family:Kalam&quot;&gt;4 · Software Factories&lt;/b&gt;&lt;br&gt;&lt;br&gt;Adds shared intake, policy, state, governance and measurement across many runs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Growth:&lt;/b&gt; governance + metrics" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=4;fontSize=18;fontColor=#222B35;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="2885" y="200" width="340" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="s06-e-1-2" value="" style="endArrow=classic;endFill=1;strokeColor=#64748B;strokeWidth=4;sketch=1;curveFitting=1;jiggle=1.5;" edge="1" parent="s06-detail-layer" source="s06-stage1" target="s06-stage2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s06-e-2-3" value="" style="endArrow=classic;endFill=1;strokeColor=#0284C7;strokeWidth=4;sketch=1;curveFitting=1;jiggle=1.5;" edge="1" parent="s06-detail-layer" source="s06-stage2" target="s06-stage3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s06-e-3-4" value="" style="endArrow=classic;endFill=1;strokeColor=#D97706;strokeWidth=4;sketch=1;curveFitting=1;jiggle=1.5;" edge="1" parent="s06-detail-layer" source="s06-stage3" target="s06-stage4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s06-detail-bottom" value="&lt;b&gt;Harness in practice:&lt;/b&gt; Slide 03 adds workflow structure. Slide 04 adds shared operations. Slide 05 makes autonomy safe with boundaries, code-run gates, proof receipts and human approval." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#DCEBF1;strokeColor=#2F6F8F;strokeWidth=3;fontSize=19;fontColor=#222B35;align=center;spacing=18;fontFamily=Inter;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="1760" y="665" width="1465" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="s06-detail-rule" value="The stages are a presentation taxonomy—not an industry standard or a strict maturity ladder." style="text;html=1;whiteSpace=wrap;align=center;fontSize=17;fontColor=#5B6672;fontFamily=Inter;fontStyle=2;" vertex="1" parent="s06-detail-layer">
                    <mxGeometry x="1900" y="805" width="1180" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="s06-detail-counter" value="06 / 09" style="text;html=1;whiteSpace=wrap;align=right;fontSize=16;fontColor=#5B6672;fontFamily=Inter;" vertex="1" parent="s06-detail-layer">
