                </mxCell>
                <mxCell id="s06-def-env" value="&lt;b style=&quot;font-size:24px;font-family:Kalam&quot;&gt;Environment&lt;/b&gt;&lt;br&gt;External context the agent observes and interacts with: users, systems, data, resources and constraints." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#F6E3DC;strokeColor=#B4533C;strokeWidth=3;fontSize=17;fontColor=#222B35;align=left;spacing=14;fontFamily=Inter;" vertex="1" parent="s06-main-layer">
                    <mxGeometry x="870" y="180" width="650" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="s06-def-agent" value="&lt;b style=&quot;font-size:24px;font-family:Kalam&quot;&gt;Agent&lt;/b&gt;&lt;br&gt;Autonomous entity that perceives, decides and acts." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FFFDF7;strokeColor=#6B5E4B;strokeWidth=3;dashed=1;fontSize=17;fontColor=#222B35;align=left;spacing=14;fontFamily=Inter;" vertex="1" parent="s06-main-layer">
                    <mxGeometry x="870" y="325" width="650" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="s06-def-harness" value="&lt;b style=&quot;font-size:24px;font-family:Kalam&quot;&gt;Harness&lt;/b&gt;&lt;br&gt;Tools, guardrails and workflows that give the agent capabilities safely and reliably." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#DCEBF1;strokeColor=#2F6F8F;strokeWidth=3;fontSize=17;fontColor=#222B35;align=left;spacing=14;fontFamily=Inter;" vertex="1" parent="s06-main-layer">
