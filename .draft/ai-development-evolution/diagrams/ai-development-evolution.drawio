                    <mxGeometry height="30" width="180" x="1380" y="850" as="geometry"/>
                </mxCell>
                <mxCell id="s03-detail-layer" parent="0" value="Detail screen"/>
                <mxCell id="s03-detail-bg" parent="s03-detail-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF8F2;strokeColor=#CBC5B5;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="900" width="1600" x="1700" as="geometry"/>
                </mxCell>
                <mxCell id="s03-detail-title" parent="s03-detail-layer" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=40;fontStyle=1;fontColor=#222B35;fontFamily=Kalam;" value="What One Workflow Includes" vertex="1">
                    <mxGeometry height="66" width="980" x="1760" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="s03-detail-pill" parent="s03-detail-layer" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1;dashed=1;fontSize=14;fontColor=#5B6672;fontFamily=Inter;" value="DETAIL" vertex="1">
                    <mxGeometry height="36" width="130" x="3110" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="s03-boundary" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#6B5E4B;strokeWidth=2;dashed=1;fontSize=17;fontStyle=1;fontColor=#222B35;fontFamily=Inter;align=center;" value="Durable · event-triggered · autonomous can still be Stage 3 — if it coordinates one bounded process." vertex="1">
                    <mxGeometry height="50" width="1480" x="1760" y="105" as="geometry"/>
                </mxCell>
                <mxCell id="s03-deps" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;sketch=1;fillStyle=solid;fontSize=18;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=16;" value="&lt;b&gt;DEPENDENCIES&lt;/b&gt;&lt;br&gt;A task starts only when its blockers and required artifacts are ready." vertex="1">
                    <mxGeometry height="120" width="440" x="1760" y="185" as="geometry"/>
                </mxCell>
                <mxCell id="s03-fan" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;sketch=1;fillStyle=solid;fontSize=18;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=16;" value="&lt;b&gt;FAN-OUT / FAN-IN&lt;/b&gt;&lt;br&gt;Independent work runs in parallel, then converges into one integration result." vertex="1">
                    <mxGeometry height="120" width="440" x="2280" y="185" as="geometry"/>
                </mxCell>
                <mxCell id="s03-retries" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDE9E9;strokeColor=#EF4444;strokeWidth=3;sketch=1;fillStyle=solid;fontSize=18;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=16;" value="&lt;b&gt;RETRIES&lt;/b&gt;&lt;br&gt;A failed gate returns a specific next step; it does not silently become a pass." vertex="1">
                    <mxGeometry height="120" width="440" x="2800" y="185" as="geometry"/>
                </mxCell>
                <mxCell id="s03-check" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;sketch=1;fillStyle=solid;fontSize=18;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=16;" value="&lt;b&gt;CHECKPOINTS&lt;/b&gt;&lt;br&gt;Artifacts, state and evidence make the run resumable and inspectable." vertex="1">
                    <mxGeometry height="120" width="440" x="1760" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="s03-approval" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222B35;strokeWidth=3;sketch=1;fillStyle=solid;fontSize=18;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=16;" value="&lt;b&gt;HUMAN APPROVALS&lt;/b&gt;&lt;br&gt;Judgment and merge boundaries remain explicit instead of being simulated by the agent." vertex="1">
                    <mxGeometry height="120" width="440" x="2280" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="s03-gates" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;sketch=1;fillStyle=solid;fontSize=18;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=middle;spacingLeft=16;" value="&lt;b&gt;VERIFICATION GATES ①&lt;/b&gt;&lt;br&gt;Evidence is checked between phases before the workflow advances." vertex="1">
                    <mxGeometry height="120" width="440" x="2800" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="s03-zoom" edge="1" parent="s03-detail-layer" style="endArrow=classic;endFill=1;strokeColor=#D97706;strokeWidth=4;sketch=1;curveFitting=1;jiggle=1.5;fontSize=24;fontStyle=1;fontColor=#222B35;labelBackgroundColor=#FAF8F2;fontFamily=Kalam;" value="ZOOM INTO ONE STATION">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1830" y="535" as="sourcePoint"/>
                        <mxPoint x="3150" y="535" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s03-sssf" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;sketch=1;fillStyle=solid;fontSize=18;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=top;spacing=18;" value="&lt;b&gt;SSSF example&lt;/b&gt;&lt;br&gt;&lt;br&gt;Deterministic Python owns phase sequencing.&lt;br&gt;&lt;br&gt;Typed envelopes carry bounded handoffs.&lt;br&gt;&lt;br&gt;Gate checks and retries control progression.&lt;br&gt;&lt;br&gt;SQLite stores a trace of the run." vertex="1">
                    <mxGeometry height="245" width="700" x="1760" y="585" as="geometry"/>
                </mxCell>
                <mxCell id="s03-notfactory" parent="s03-detail-layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B5E4B;strokeWidth=3;dashed=1;fontSize=18;fontColor=#222B35;fontFamily=Inter;align=left;verticalAlign=top;spacing=18;" value="&lt;b&gt;What this does not prove&lt;/b&gt;&lt;br&gt;&lt;br&gt;One durable run is not yet a factory.&lt;br&gt;&lt;br&gt;Stage 4 adds cross-work intake, shared policy, governance, measurement and improvement across runs.&lt;br&gt;&lt;br&gt;The trigger changes how a workflow starts—not what unit it governs." vertex="1">
                    <mxGeometry height="245" width="700" x="2540" y="585" as="geometry"/>
                </mxCell>
                <mxCell id="s03-detail-counter" parent="s03-detail-layer" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=16;fontColor=#5B6672;fontFamily=Inter;" value="03 / 09" vertex="1">
                    <mxGeometry height="30" width="180" x="3080" y="850" as="geometry"/>
                </mxCell>
