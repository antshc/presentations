                <mxCell id="s09-d1" parent="s09-detail" vertex="1" value="&lt;b&gt;1 · BUILD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Sprinter reads the task, edits code, runs the normal checks, and hands off a candidate.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=3;fontSize=21;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=16;spacingRight=12;">
                    <mxGeometry x="1760" y="175" width="340" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="s09-d2" parent="s09-detail" vertex="1" value="&lt;b&gt;2 · HAND OFF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;A clean boundary: code plus the claim to test. “Done” is not a verdict.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FFFFFF;strokeColor=#CBC5B5;strokeWidth=3;fontSize=21;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=16;spacingRight=12;">
                    <mxGeometry x="2135" y="175" width="340" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="s09-d3" parent="s09-detail" vertex="1" value="&lt;b&gt;3 · VERIFY ②&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Mole runs the app, tests reload + persistence + gotchas, and collects screenshots and logs.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;fontSize=21;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=16;spacingRight=12;">
                    <mxGeometry x="2510" y="175" width="340" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="s09-d4" parent="s09-detail" vertex="1" value="&lt;b&gt;4 · VERDICT ①&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;PASS&lt;/b&gt; with proof · &lt;b&gt;FAIL&lt;/b&gt; with next step · &lt;b&gt;CAN’T TELL&lt;/b&gt; when evidence is missing.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=1.5;fillStyle=solid;fillColor=#FDE9E9;strokeColor=#EF4444;strokeWidth=3;fontSize=21;fontColor=#222B35;fontFamily=Inter;align=left;spacingLeft=16;spacingRight=12;">
